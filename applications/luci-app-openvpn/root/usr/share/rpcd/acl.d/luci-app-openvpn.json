{
	"luci-app-openvpn": {
		"description": "Configuration access for OpenVPN LuCI app",
		"read": {
			"cgi": [ "luci" ],
			"uci": [ "openvpn" ],
			"ubus": {
				"system": [ "info" ],
				"service": [ "list" ],
				"network": [ "status" ]
			},
			"file": {
				"/etc/openvpn/luci/*": [ "read" ],
				"/etc/openvpn/keys/*": [ "read" ],
				"/var/run/openvpn.keygen.lock": [ "read" ],
				"/proc/uptime": [ "read" ],
				"/proc/net/dev": [ "read" ],
				"/tmp/openvpn.keygen.log": [ "read" ],
				"/tmp/openvpn.keygen.ca.tmp": [ "read" ],
				"/tmp/openvpn.keygen.server-key.tmp": [ "read" ],
				"/tmp/openvpn.keygen.server-cert.tmp": [ "read" ],
				"/tmp/openvpn.keygen.client-key.tmp": [ "read" ],
				"/tmp/openvpn.keygen.client-cert.tmp": [ "read" ],
				"/tmp/openvpn.keygen.dh.tmp": [ "read" ],
				"/tmp/openvpn.keygen.tls.tmp": [ "read" ]
			}
		},
		"write": {
			"uci": [ "openvpn" ],
			"file": {
				"/etc/openvpn/luci/*": [ "write" ],
				"/etc/openvpn/keys/*": [ "write" ],
				"/etc/config/openvpn": [ "write" ],
				"/usr/libexec/luci-app-openvpn": [ "exec" ]
			}
		}
	}
}

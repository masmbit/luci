#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

# Register custom actions to pass through rc.common validation
EXTRA_COMMANDS="keygen keymeta"
EXTRA_HELP=\
"	keygen		Asynchronous key and certificate generator
	keymeta		Validate and extract cryptographic metadata for LuCI"

# Asynchronous key and certificate generator
keygen() {
	local type="${1:-unknown}"
	local instance="${2:-default}"
	
	# Sane 2048 fallback prevents syntax drops on the CA layer
	local bits="${3:-2048}"
	local days="${4:-36500}"
	local custom="$5"
	
	local log_file="/tmp/openvpn.keygen.log"
	
	# Explicit flat RAM staging nodes matching your authorized ACL matrix
	local out_ca_file="/tmp/openvpn.keygen.ca.tmp"
	local out_server_key_file="/tmp/openvpn.keygen.server-key.tmp"
	local out_server_cert_file="/tmp/openvpn.keygen.server-cert.tmp"
	local out_dh_file="/tmp/openvpn.keygen.dh.tmp"
	local out_tls_file="/tmp/openvpn.keygen.tls.tmp"

	local active_out=""
	local ca_key_buffer=""
	local ca_cert_buffer=""
	local ca_engine=""
	local ec_param_tmp=""

	# General poller log reset happens synchronously to clear the terminal view
	rm -f "$log_file"
	touch "$log_file"
	chmod 666 "$log_file"

	case "$type" in
		"ca")
			active_out="$out_ca_file"
			rm -f "$out_ca_file" "$out_server_key_file" "$out_server_cert_file" "$out_dh_file" "$out_tls_file"
			
			ca_key_buffer="$out_ca_file"
			ca_cert_buffer="$out_server_cert_file"
			
			# DYNAMIC ENGINE MATRIX: Detect if we need to spawn an RSA or a Pure ECC Certificate Authority
			ca_engine="-newkey rsa:$bits"
			if [ "$bits" = "ec" ]; then
				ec_param_tmp="/tmp/openvpn.keygen.dh.tmp"
				rm -f "$ec_param_tmp"
				
				echo "[CMD] openssl ecparam -name prime256v1 -out $ec_param_tmp" >> "$log_file"
				openssl ecparam -name prime256v1 -out "$ec_param_tmp" 2>> "$log_file"
				
				ca_engine="-newkey ec:$ec_param_tmp"
			fi
			
			# TRUE ASYNC BYPASS: Shield the entire CA creation phase in the background
			(
				set +e
				if [ -n "$custom" ]; then
					echo "LOG: Invoking openssl engine for self-signed CA generation..." >> "$log_file"
					echo "[CMD] openssl req -new -x509 -nodes -days $days $ca_engine -subj \"/CN=OpenVPN-CA-$instance\" -keyout $ca_key_buffer -out $ca_cert_buffer $custom" >> "$log_file"
					openssl req -new -x509 -nodes -days "$days" $ca_engine -subj "/CN=OpenVPN-CA-$instance" -keyout "$ca_key_buffer" -out "$ca_cert_buffer" $custom >/dev/null 2>> "$log_file"
				else
					echo "LOG: Invoking openssl engine for self-signed CA generation..." >> "$log_file"
					echo "[CMD] openssl req -new -x509 -nodes -days $days $ca_engine -subj \"/CN=OpenVPN-CA-$instance\" -keyout $ca_key_buffer -out $ca_cert_buffer" >> "$log_file"
					openssl req -new -x509 -nodes -days "$days" $ca_engine -subj "/CN=OpenVPN-CA-$instance" -keyout "$ca_key_buffer" -out "$ca_cert_buffer" >/dev/null 2>> "$log_file"
				fi
				
				# We append the unique certificate block into the key container. 
				if [ -f "$ca_key_buffer" ] && [ -s "$ca_key_buffer" ] && [ -f "$ca_cert_buffer" ] && [ -s "$ca_cert_buffer" ]; then
					cat "$ca_cert_buffer" >> "$ca_key_buffer"
					chmod 644 "$active_out"
					echo "LOG: WORKFLOW_SUCCESSFUL" >> "$log_file"
				else
					echo "ERROR: Cryptographic CA asset generation returned structural failure." >> "$log_file"
				fi
				
				rm -f "$ca_cert_buffer" "/tmp/openvpn.keygen.dh.tmp"
				set -e
			) &
			;;

		"server-key")
			active_out="$out_server_key_file"
			rm -f "$active_out"
			
			# TRUE ASYNC BYPASS: Shift private key generation into background subshell
			(
				set +e
				if [ "$bits" = "ec" ]; then
					echo "LOG: Invoking openssl engine for ECC private key generation..." >> "$log_file"
					echo "[CMD] openssl ecparam -name prime256v1 -genkey -out $active_out $custom" >> "$log_file"
					openssl ecparam -name prime256v1 -genkey -out "$active_out" $custom 2>> "$log_file"
				else
					echo "LOG: Invoking openssl engine for RSA private key generation..." >> "$log_file"
					echo "[CMD] openssl genrsa -out $active_out $custom $bits" >> "$log_file"				
					openssl genrsa -out "$active_out" $custom "$bits" 2>> "$log_file"
				fi
				
				if [ -f "$active_out" ] && [ -s "$active_out" ]; then
					chmod 644 "$active_out"
					echo "LOG: WORKFLOW_SUCCESSFUL" >> "$log_file"
				else
					echo "ERROR: Server private key buffer generation returned structural failure." >> "$log_file"
				fi
				set -e
			) &
			;;

		"server-cert")
			active_out="$out_server_cert_file"
			rm -f "$active_out"
			
			# TRUE ASYNC BYPASS: Shift certificate signing pipeline into background subshell
			(
				set +e
				echo "LOG: Validating local Certificate Authority access..." >> "$log_file"
				if [ ! -s "$out_ca_file" ] || [ ! -s "$out_server_key_file" ]; then
					echo "ERROR: Required multi-stage RAM staging nodes are missing or empty!" >> "$log_file"
				else
					if [ -n "$custom" ] && echo "$custom" | grep -q -- "-subj"; then
						echo "LOG: Invoking openssl engine for custom dynamic certificate signing..." >> "$log_file"
						echo "[CMD] openssl req -new -nodes -key $out_server_key_file $custom | openssl x509 -req -days $days -CA $out_ca_file -CAkey $out_ca_file -set_serial $$ -out $active_out $custom" >> "$log_file"
						openssl req -new -nodes -key "$out_server_key_file" $custom 2>/dev/null | \
							openssl x509 -req -days "$days" -CA "$out_ca_file" -CAkey "$out_ca_file" \
							-set_serial "$$" -out "$active_out" $custom 2>> "$log_file"
					else
						echo "LOG: Invoking openssl engine for dynamic certificate signing..." >> "$log_file"
						echo "[CMD] openssl req -new -nodes -key $out_server_key_file -subj \"/CN=OpenVPN-Server-$instance\" -out $active_out $custom | openssl x509 -req -days $days -CA $out_ca_file -CAkey $out_ca_file -set_serial $$ -out $active_out $custom" >> "$log_file"				
						openssl req -new -nodes -key "$out_server_key_file" \
							-subj "/CN=OpenVPN-Server-$instance" 2>/dev/null | \
							openssl x509 -req -days "$days" -CA "$out_ca_file" -CAkey "$out_ca_file" \
							-set_serial "$$" -out "$active_out" $custom 2>> "$log_file"
					fi
					
					if [ -f "$active_out" ] && [ -s "$active_out" ]; then
						chmod 644 "$active_out"
						echo "LOG: WORKFLOW_SUCCESSFUL" >> "$log_file"
					else
						echo "ERROR: Server certificate dynamic signing pipeline returned structural failure." >> "$log_file"
					fi
				fi
				set -e
			) &
			;;

		"dh")
			active_out="$out_dh_file"
			rm -f "$active_out"
			
			# TRUE ASYNC BYPASS: Shift prime bit generation into background subshell
			(
				set +e
				if [ -n "$custom" ]; then
					echo "LOG: Invoking openssl engine for fast Diffie-Hellman parameters..." >> "$log_file"
					echo "[CMD] openssl dhparam -dsaparam $custom -out $active_out $bits" >> "$log_file"
					openssl dhparam -dsaparam $custom -out "$active_out" "$bits" >> "$log_file" 2>&1
				else
					echo "LOG: Invoking openssl engine for fast Diffie-Hellman parameters..." >> "$log_file"
					echo "[CMD] openssl dhparam -dsaparam -out $active_out $bits" >> "$log_file"				
					openssl dhparam -dsaparam -out "$active_out" "$bits" 2>> "$log_file"
				fi
				
				if [ -f "$active_out" ] && [ -s "$active_out" ]; then
					chmod 644 "$active_out"
					echo "LOG: WORKFLOW_SUCCESSFUL" >> "$log_file"
				else
					echo "ERROR: Diffie-Hellman cryptographic prime generation returned structural failure." >> "$log_file"
				fi
				set -e
			) &
			;;

		"tls-crypt")
			active_out="$out_tls_file"
			rm -f "$active_out"
			
			# TRUE ASYNC BYPASS: Shift symmetric static secret generation into background subshell
			(
				set +e
				echo "LOG: Invoking openvpn engine for symmetric static key secret..." >> "$log_file"
				echo "[CMD] openvpn --genkey secret $active_out $custom" >> "$log_file"
				openvpn --genkey secret "$active_out" $custom 2>> "$log_file"
				
				if [ -f "$active_out" ] && [ -s "$active_out" ]; then
					chmod 644 "$active_out"
					echo "LOG: WORKFLOW_SUCCESSFUL" >> "$log_file"
				else
					echo "ERROR: Symmetric secret key engine tokens returned structural failure." >> "$log_file"
				fi
				set -e
			) &
			;;

		*)
			echo "ERROR: Invalid cryptographic profile requested." >> "$log_file"
			exit 1
			;;
	esac
}

# Validate and extract cryptographic metadata for LuCI
keymeta() {
	local filename="$1"
	local absolute_path="/etc/openvpn/keys/$filename"
	local hex_lines_count=0

	# Hard validation guard against directory traversal attacks
	if [ -z "$filename" ] || echo "$filename" | grep -q '\.\.'; then
		echo "ERROR: Invalid or restricted filename frame context."
		exit 1
	fi

	if [ -s "$absolute_path" ]; then
		# Case A: Check for valid Certificate (CA or Server Certificate)
		if grep -q "BEGIN CERTIFICATE" "$absolute_path"; then
			openssl x509 -in "$absolute_path" -noout -text 2>/dev/null | \
				grep -E "Not After|Public-Key|ASN1 OID|[Nn][Ii][Ss][Tt]|[Cc]urve" | sed 's/^[[:space:]]*//'
		
		# Case B: Check for standalone Private Keys (RSA or ECC)
		elif grep -q "BEGIN PRIVATE KEY" "$absolute_path" || grep -q "BEGIN RSA PRIVATE KEY" "$absolute_path" || grep -q "BEGIN EC PRIVATE KEY" "$absolute_path"; then
			openssl pkey -in "$absolute_path" -noout -text 2>/dev/null | \
				grep -E "Private-Key|ASN1 OID|[Nn][Ii][Ss][Tt]|[Cc]urve" | sed 's/^[[:space:]]*//'
		
		# Case C: Check for standalone Diffie-Hellman Parameter matrices (Classic & X9.42)
		elif grep -q "DH PARAMETERS" "$absolute_path"; then
			# Using the universal pkeyparam engine to stream meta tags for both PKCS#3 and X9.42 formats
			openssl pkeyparam -in "$absolute_path" -noout -text 2>/dev/null | \
				grep -E "DH Parameters|bit" | sed 's/^[[:space:]]*//'
		
		# Case D: Check for OpenVPN Static Keys (e.g. tls-crypt)
		elif grep -q "BEGIN OpenVPN Static key" "$absolute_path"; then
			hex_lines_count=$(grep -v "BEGIN" "$absolute_path" | grep -v "END" | tr -d '\r' | grep -E -c "^[0-9a-fA-F]{32}$")

			if [ "$hex_lines_count" -eq 16 ] && grep -q "END OpenVPN Static key" "$absolute_path"; then
				echo "TYPE: Symmetric Static Secret (2048 Bit) - Validated"
			else
				echo "ERROR: OpenVPN static key validation failed (Structural format corruption)."
			fi
		else
			echo "TYPE: Custom Raw Data Structure"
		fi
	else
		echo "ERROR: Staging node file is empty or missing."
	fi
}

generate_default_keys() {
	local key_dir="/etc/openvpn/keys"
	local missing=0
	local exit_code=0
	local dummy_payload="MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAzV1c4B9x9C3x"

	# Step 1: Check physical existence on disk partition
	[ -f "$key_dir/ca_default.crt" ] || missing=1
	[ -f "$key_dir/server_default.crt" ] || missing=1
	[ -f "$key_dir/server_default.key" ] || missing=1
	[ -f "$key_dir/dh_default.pem" ] || missing=1
	[ -f "$key_dir/tls-crypt_default.key" ] || missing=1

	[ "$missing" -eq 1 ] || return 0

	mkdir -p "$key_dir"
	touch /var/run/openvpn.keygen.lock
	trap 'rm -f /var/run/openvpn.keygen.lock' EXIT INT TERM

	if command -v openssl >/dev/null 2>&1 && command -v openvpn >/dev/null 2>&1; then
		# 1. Generate combined CA key and certificate symmetrically using robust RSA 2048 for global compatibility
		openssl req -new -x509 -nodes -days 36500 -newkey rsa:2048 \
			-keyout "$key_dir/ca_default.crt" \
			-subj "/CN=OpenWrt-Multi-CA" 2>/dev/null && \
		openssl req -new -x509 -nodes -days 36500 -key "$key_dir/ca_default.crt" \
			-subj "/CN=OpenWrt-Multi-CA" 2>/dev/null >> "$key_dir/ca_default.crt" && \
			
		# 2. FIXED: Generate Server Private Key using high-performance ECC (Prime256v1) instead of heavy RSA
		openssl req -new -nodes -newkey ec:<(openssl ecparam -name prime256v1) \
			-keyout "$key_dir/server_default.key" \
			-out "$key_dir/server_default.csr" \
			-subj "/CN=OpenWrt-Server" 2>/dev/null && \
			
		# 3. Sign the ECC server cert mathematically secure using the RSA ca_default.crt layer
		openssl x509 -req -days 36500 \
			-in "$key_dir/server_default.csr" \
			-CA "$key_dir/ca_default.crt" \
			-CAkey "$key_dir/ca_default.crt" \
			-set_serial "$$" \
			-out "$key_dir/server_default.crt" 2>/dev/null && \
			
		# Generate DH (with fast dsaparam) and TLS-Crypt assets safely
		openssl dhparam -dsaparam -out "$key_dir/dh_default.pem" 1024 2>/dev/null && \
		openvpn --genkey secret "$key_dir/tls-crypt_default.key" 2>/dev/null
		
		exit_code=$?
		if [ "$exit_code" -ne 0 ]; then
			missing=1
		else
			missing=0
		fi

		# Flush volatile temporary components safely (no .csr or .srl files left on disk!)
		rm -f "$key_dir/server_default.csr"
	fi

	if [ "$missing" -eq 1 ]; then
		[ -f "$key_dir/ca_default.crt" ] || printf -- "-----BEGIN CERTIFICATE-----\n%s\n-----END CERTIFICATE-----\n" "$dummy_payload" > "$key_dir/ca_default.crt"
		[ -f "$key_dir/server_default.crt" ] || printf -- "-----BEGIN CERTIFICATE-----\n%s\n-----END CERTIFICATE-----\n" "$dummy_payload" > "$key_dir/server_default.crt"
		[ -f "$key_dir/server_default.key" ] || printf -- "-----BEGIN PRIVATE KEY-----\n%s\n-----END PRIVATE KEY-----\n" "$dummy_payload" > "$key_dir/server_default.key"
		[ -f "$key_dir/dh_default.pem" ] || printf -- "-----BEGIN DH PARAMETERS-----\n%s\n-----END DH PARAMETERS-----\n" "$dummy_payload" > "$key_dir/dh_default.pem"
		[ -f "$key_dir/tls-crypt_default.key" ] || printf -- "-----BEGIN OpenVPN Static key v1-----\n%s\n-----END OpenVPN Static key v1-----\n" "$dummy_payload" > "$key_dir/tls-crypt_default.key"
	fi

	rm -f /var/run/openvpn.keygen.lock
	trap - EXIT INT TERM
}


set_firewall_rules_openvpn() {
	local need_reload=0

	# 1. Create a dedicated, secure firewall zone for OpenVPN (tun+ interfaces) if missing
	if ! uci -q get firewall.openvpn_zone >/dev/null; then
		uci set firewall.openvpn_zone=zone
		uci set firewall.openvpn_zone.name="openvpn"
		uci set firewall.openvpn_zone.input="ACCEPT"
		uci set firewall.openvpn_zone.forward="ACCEPT"
		uci set firewall.openvpn_zone.output="ACCEPT"
		uci set firewall.openvpn_zone.device="tun+"
		need_reload=1
	else
		# Cleanup: Remove orphan network option if it still exists from old configs
		if [ "$(uci -q get firewall.openvpn_zone.network)" = "vpn" ]; then
			uci del firewall.openvpn_zone.network
			need_reload=1
		fi
	fi

	# 2. Establish forward rule from OpenVPN zone to WAN (Allows Internet Routing)
	if ! uci -q get firewall.openvpn_to_wan >/dev/null; then
		uci set firewall.openvpn_to_wan=forwarding
		uci set firewall.openvpn_to_wan.name="openvpn-to-wan"
		uci set firewall.openvpn_to_wan.src="openvpn"
		uci set firewall.openvpn_to_wan.dest="wan"
		need_reload=1
	fi

	# 3. Establish forward rule from OpenVPN zone to LAN (Allows Local Network Access)
	if ! uci -q get firewall.openvpn_to_lan >/dev/null; then
		uci set firewall.openvpn_to_lan=forwarding
		uci set firewall.openvpn_to_lan.name="openvpn-to-lan"
		uci set firewall.openvpn_to_lan.src="openvpn"
		uci set firewall.openvpn_to_lan.dest="lan"
		need_reload=1
	fi

	# 4. Establish forward rule from LAN zone back to OpenVPN zone (Allows bidirectional routing)
	if ! uci -q get firewall.lan_to_openvpn >/dev/null; then
		uci set firewall.lan_to_openvpn=forwarding
		uci set firewall.lan_to_openvpn.name="lan-to-openvpn"
		uci set firewall.lan_to_openvpn.src="lan"
		uci set firewall.lan_to_openvpn.dest="openvpn"
		need_reload=1
	fi

	# Only commit and reload if changes were actually written to prevent staging destruction
	if [ "$need_reload" -eq 1 ]; then
		uci commit firewall
		/etc/init.d/firewall reload
	fi
}

cleanup_orphaned_configs() {
	local conf_file
	local filename
	local key_dir="/etc/openvpn/keys"

	# Scan for all configuration files on the disk partition
	for conf_file in /etc/openvpn/instance*.conf; do
		if [ -f "$conf_file" ]; then
			# Native POSIX extraction (e.g., transforms /etc/openvpn/instance3.conf into instance3)
			filename="${conf_file##*/}"
			filename="${filename%.conf}"
			
			# If the corresponding UCI section is permanently gone, execute flat file and crypto purge
			if ! uci -q get openvpn.$filename >/dev/null; then
				# 1. Wipe out the main configuration file target
				rm -f "$conf_file"

				# 2. Automated crypto cleanup: Purge all orphaned instance-specific keys matching the filename
				rm -f "$key_dir/ca_${filename}.crt"
				rm -f "$key_dir/dh_${filename}.pem"
				rm -f "$key_dir/server_${filename}.crt"
				rm -f "$key_dir/server_${filename}.key"
				rm -f "$key_dir/tls-crypt_${filename}.key"
			fi
		fi
	done
}

start_instance() {
	local section="$1"
	local enabled
	local config

	config_get_bool enabled "$section" enabled 0
	config_get config "$section" config

	[ "$enabled" -gt 0 ] || return 0
	[ -f "$config" ] || return 1

	# Map instance runtime configuration variables flatly into the procd daemon stream
	procd_open_instance "$section"
	procd_set_param command /usr/sbin/openvpn \
		--syslog "openvpn($section)" \
		--writepid "/var/run/openvpn.$section.pid" \
		--status "/var/run/openvpn.$section.status" 5 \
		--cd /etc/openvpn \
		--config "$config"
	procd_set_param respawn
	procd_close_instance
}

start_service() {
	# Step-by-step sequential environment alignment hooks execution
	generate_default_keys
	set_firewall_rules_openvpn
	cleanup_orphaned_configs

	config_load openvpn
	config_foreach start_instance openvpn
}

stop_service() {
	# Clear tracking runtime matrices to prevent uncoordinated PID data leaks
	rm -f /var/run/openvpn.instance*.pid
	rm -f /var/run/openvpn.instance*.status
}

service_triggers() {
	procd_add_reload_trigger "openvpn"
}
